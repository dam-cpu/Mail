<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Título Principal -->
    <TextView
        android:id="@+id/txtRedactar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/redactar"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Campo DE -->
    <TextView
        android:id="@+id/txtDe"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:text="@string/de"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/edtDe"
        app:layout_constraintBottom_toBottomOf="@id/edtDe" />

    <EditText
        android:id="@+id/edtDe"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:inputType="textEmailAddress"
        app:layout_constraintTop_toBottomOf="@id/txtRedactar"
        app:layout_constraintStart_toEndOf="@id/txtDe"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Campo PARA -->
    <TextView
        android:id="@+id/txtPara"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:text="@string/para"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/edtPara"
        app:layout_constraintBottom_toBottomOf="@id/edtPara" />

    <EditText
        android:id="@+id/edtPara"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:inputType="textEmailAddress"
        app:layout_constraintTop_toBottomOf="@id/edtDe"
        app:layout_constraintStart_toEndOf="@id/txtPara"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Campo CC -->
    <TextView
        android:id="@+id/txtCopia"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:text="@string/cc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/edtCC"
        app:layout_constraintBottom_toBottomOf="@id/edtCC" />

    <EditText
        android:id="@+id/edtCC"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:inputType="textEmailAddress"
        app:layout_constraintTop_toBottomOf="@id/edtPara"
        app:layout_constraintStart_toEndOf="@id/txtCopia"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Campo CCo -->
    <TextView
        android:id="@+id/txtOculta"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:text="@string/cco"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/edtCCo"
        app:layout_constraintBottom_toBottomOf="@id/edtCCo" />

    <EditText
        android:id="@+id/edtCCo"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:inputType="textEmailAddress"
        app:layout_constraintTop_toBottomOf="@id/edtCC"
        app:layout_constraintStart_toEndOf="@id/txtOculta"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Campo ASUNTO -->
    <TextView
        android:id="@+id/txtAsunto"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:text="@string/asunto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/edtAsunto"
        app:layout_constraintBottom_toBottomOf="@id/edtAsunto" />

    <EditText
        android:id="@+id/edtAsunto"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/edtCCo"
        app:layout_constraintStart_toEndOf="@id/txtAsunto"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Campo MENSAJE -->
    <EditText
        android:id="@+id/edtMensaje"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:inputType="textMultiLine"
        android:gravity="top|start"
        app:layout_constraintTop_toBottomOf="@id/edtAsunto"
        app:layout_constraintBottom_toTopOf="@id/btnAceptar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <!-- Botón ACEPTAR -->
    <Button
        android:id="@+id/btnAceptar"
        android:layout_width="130dp"
        android:layout_height="50dp"
        android:text="@string/aceptar"
        android:textAllCaps="false"
        android:backgroundTint="#FF2196F3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnCancelar"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <!-- Botón CANCELAR -->
    <Button
        android:id="@+id/btnCancelar"
        android:layout_width="130dp"
        android:layout_height="50dp"
        android:text="@string/cancelar"
        android:textAllCaps="false"
        android:backgroundTint="#FF2196F3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnAceptar"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>